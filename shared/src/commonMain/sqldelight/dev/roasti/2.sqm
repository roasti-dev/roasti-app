CREATE TABLE RecipeStep (
    recipe_id TEXT NOT NULL,
    step_order INTEGER NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    duration_seconds INTEGER,
    image_id TEXT,
    PRIMARY KEY (recipe_id, step_order)
);
